APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8765

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3010,127.0.0.1,127.0.0.1:8000,127.0.0.1:8765,localhost:8765,::1
SANCTUM_TOKEN_PREFIX=
SANCTUM_TOKEN_EXPIRATION=43200
AUTH_LOGIN_WAIT_DURATION_MS=1000
ADMIN_USER_USERNAME=Admin
ADMIN_USER_PASSWORD=admin

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Each open watch-progress stream holds one worker (needs serve --no-reload, as in composer dev)
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=7563
DB_DATABASE=moviebrowser3
DB_USERNAME=moviebrowser
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Seconds between checks of which episode and position an open VLC window is playing
VLC_TRACK_INTERVAL_SECONDS=5

# The host bridge (deploy/host_bridge.py) starts VLC and copies files between Windows drives, for a backend in Docker
# that can't. The token must match the bridge's
HOST_BRIDGE_ENABLED=false
HOST_BRIDGE_URL=http://127.0.0.1:8767
HOST_BRIDGE_TOKEN=

# Watch progress stream (GET watch-progress/stream): seconds between progress checks,
# between heartbeats while idle, and before the server closes the stream (the client reconnects)
WATCH_PROGRESS_STREAM_POLL_SECONDS=2
WATCH_PROGRESS_STREAM_HEARTBEAT_SECONDS=25
WATCH_PROGRESS_STREAM_LIFETIME_SECONDS=3600

# Seconds before the end of an episode from which it counts as watched: the last episode then completes its entry
WATCH_FINISHED_BEFORE_END_SECONDS=120

# Update notice (GET app-version, admins): the repos whose newest GitHub release is compared with the running
# version (the installer's repo answers in production), and how long a found or failed check is reused, in seconds
MOVIEBROWSER3_BACKEND_REPO=https://github.com/NicoHeinola/MovieBrowser3_backend
MOVIEBROWSER3_FRONTEND_REPO=https://github.com/NicoHeinola/MovieBrowser3_frontend
RELEASE_CHECK_CACHE_SECONDS=3600

# Folders the production installer mounts into the containers (":"-separated); paths outside them are not visible.
# Empty in dev, where every path is
# MOVIEBROWSER3_MEDIA_DIRS=

# Database backups: the folder for the dumps (empty = storage/app/backups), how many hours between them, how many to keep
# BACKUP_PATH=
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
