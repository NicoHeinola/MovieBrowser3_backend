#!/usr/bin/env bash
# MovieBrowser3 control command, installed to ~/.local/bin by install.sh.
set -euo pipefail

# The install dir is where this script lives (~/.local/bin/moviebrowser3 links to it), whatever MOVIEBROWSER3_DIR says
export MOVIEBROWSER3_DIR="$(dirname "$(readlink -f "$0")")"
cd "$MOVIEBROWSER3_DIR"

case "${1:-help}" in
    update)
        # The installer with the saved answers: fast-forward both clones, refresh the deploy files, build, migrate,
        # restart
        exec bash MovieBrowser3_backend/deploy/install.sh --update
        ;;
    start) docker compose up -d ;;
    stop) docker compose down ;;
    restart) docker compose restart ;;
    status) docker compose ps ;;
    logs)
        shift
        docker compose logs --follow --tail=100 "$@"
        ;;
    artisan)
        shift
        docker compose run --rm backend php artisan "$@"
        ;;
    *)
        cat <<USAGE
Usage: moviebrowser3 <command>

  update            Pull GitHub main into both clones, rebuild, migrate and restart
  start | stop      Start or stop every service
  restart           Restart every service
  status            Show the services
  logs [service]    Follow the logs (db, backend, queue)
  artisan <args>    Run an artisan command in a one-off backend container

USAGE
        ;;
esac
