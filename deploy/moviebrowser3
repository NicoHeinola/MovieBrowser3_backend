#!/usr/bin/env bash
# MovieBrowser3 control command, installed to ~/.local/bin by install.sh.
set -euo pipefail

# The install dir is where this script lives (~/.local/bin/moviebrowser3 links to it), whatever MOVIEBROWSER3_DIR says.
# Exported so `update` keeps installing into this folder.
export MOVIEBROWSER3_DIR="$(dirname "$(readlink -f "$0")")"
INSTALL_DIR=$MOVIEBROWSER3_DIR

# Paths given as arguments are relative to where the command was run, not to the install dir
caller_dir=$PWD
cd "$INSTALL_DIR"

# Copied next to this script by install.sh
for module in common env bridge; do
    # shellcheck source=/dev/null
    source "$INSTALL_DIR/lib/$module.sh"
done
unset module
# No step headers here, so the lines start at the margin
INDENT=""

usage() {
    cat <<USAGE
Usage: moviebrowser3 <command>

  update            Check out the newest release of both clones, rebuild, migrate and restart
  start | stop      Start or stop every service and the host bridge
  restart           Restart every service and the host bridge
  bridge <start|stop|restart>
                    Only the host bridge
  status            Show the services and whether the host bridge answers
  logs [service]    Follow the logs (db, backend, queue, imports, scheduler)
  artisan <args>    Run an artisan command in a one-off backend container
  backup            Back up the database now, into the backup folder (BACKUP_PATH in .env)
  restore <backup> [--yes]
                    Replace the database with a backup: a file name from the backup folder, or a path

USAGE
}

status() {
    docker compose ps
    echo
    if bridge_up; then
        echo "host bridge: running"
    else
        echo "host bridge: not running (moviebrowser3 bridge start)"
    fi
}

bridge() {
    case "${1:-}" in
        start) start_bridge ;;
        stop) stop_bridge ;;
        restart)
            stop_bridge
            start_bridge
            ;;
        *) fail "Usage: moviebrowser3 bridge <start|stop|restart>" ;;
    esac
}

# restore <backup> [--yes]: replaces the whole database with a dump from `backup` or the scheduled backups
restore() {
    (($# >= 1)) || fail "Usage: moviebrowser3 restore <backup> [--yes]"

    # A bare name is one from the backup folder, as the admin page lists them
    local file backup_dir
    backup_dir=$(env_get BACKUP_PATH)
    if [[ "$1" != */* && -n "$backup_dir" && -f "$backup_dir/$1" ]]; then
        file="$backup_dir/$1"
    else
        file=$(cd "$caller_dir" && readlink -f "$1" || true)
    fi
    [[ -f "$file" ]] || fail "Backup not found: $1 (is the backup folder's drive mounted?)"

    if [[ "${2:-}" != --yes ]]; then
        local answer
        echo "This replaces the whole database with $(basename "$file"). Everything changed since that backup is lost."
        read -r -p "Type yes to continue: " answer </dev/tty
        [[ "$answer" == yes ]] || fail "Cancelled; nothing changed."
    fi

    # Opened now, so the dump stays readable whatever happens to the file below
    exec 3<"$file"

    # Nothing may write while the tables are replaced
    docker compose stop backend queue imports scheduler
    docker compose up -d --wait db

    # The current database, in case the restore was the wrong call. A broken database may not dump, which is no reason
    # to stop. --no-prune: one more dump would otherwise delete the oldest, which may be the one being restored.
    docker compose run --rm -T backend php artisan backups:create --label=before-restore --no-prune ||
        warn "Couldn't back up the current database first; restoring anyway."

    # Drops every table first, so tables newer than the backup don't linger and trip the migrations below. Runs in the
    # db container, so pg_restore matches the server's version, as the container's own user:
    # 1. pg_restore turns the whole dump into SQL first. Piped straight into psql, a truncated dump would end the SQL
    #    early and psql would commit the dropped schema.
    # 2. psql runs it in one transaction, so a restore that fails halfway leaves the database as it was.
    local status=0
    # shellcheck disable=SC2016 # expanded inside the container
    docker compose exec -T db sh -c 'set -e
        trap "rm -f /tmp/moviebrowser3-restore.sql" EXIT
        pg_restore --no-owner -f /tmp/moviebrowser3-restore.sql
        { echo "SET client_min_messages = warning; DROP SCHEMA public CASCADE; CREATE SCHEMA public;"; cat /tmp/moviebrowser3-restore.sql; } |
            psql -q -o /dev/null -v ON_ERROR_STOP=1 --single-transaction -U "$POSTGRES_USER" -d "$POSTGRES_DB"' <&3 || status=$?
    exec 3<&-

    # A backup from an older version has an older schema
    local migrated=0
    ((status != 0)) || docker compose run --rm -T backend php artisan migrate --force || migrated=$?

    docker compose up -d
    ((status == 0)) || fail "The restore failed and the database is unchanged; check the output above. The services were started again."
    ((migrated == 0)) ||
        fail "Restored the database from $file, but the migrations failed; check the output above, then run: moviebrowser3 artisan migrate --force"
    echo "Restored the database from $file."
}

command=${1:-help}
shift || true

case "$command" in
    # The installer with the saved answers: fetch both clones, refresh the deploy files, build, migrate, restart
    update) exec bash MovieBrowser3_backend/deploy/install.sh --update ;;

    start)
        docker compose up -d
        start_bridge
        ;;
    stop)
        docker compose down
        stop_bridge
        ;;
    restart)
        docker compose restart
        stop_bridge
        start_bridge
        ;;

    bridge) bridge "$@" ;;
    status) status ;;
    logs) docker compose logs --follow --tail=100 "$@" ;;
    artisan) docker compose run --rm backend php artisan "$@" ;;
    backup) docker compose run --rm -T backend php artisan backups:create ;;
    restore) restore "$@" ;;
    *) usage ;;
esac
