# MovieBrowser3 production settings: the template install.sh copies into the install folder's .env on the first
# install. Every run after that adds any key from here that .env doesn't have yet, so new settings arrive with these
# defaults, and existing values stay. Docker Compose, the backend and the VLC bridge all read the resulting .env.
#
# Left empty here, filled by install.sh: the secrets (APP_KEY, DB_PASSWORD, VLC_BRIDGE_TOKEN), the host user
# (APP_UID, APP_GID) and the installer's answers below, which it rewrites on every run. Edit anything else in the
# install folder's .env, then run: moviebrowser3 start

# The host user the containers run as, so files they write stay yours
APP_UID=
APP_GID=

# Installer answers: the repos to build from, and the media folders (":"-separated, mounted at the same path)
MOVIEBROWSER3_BACKEND_REPO=https://github.com/NicoHeinola/MovieBrowser3_backend
MOVIEBROWSER3_FRONTEND_REPO=https://github.com/NicoHeinola/MovieBrowser3_frontend
MOVIEBROWSER3_MEDIA_DIRS=

# Where the app (API and frontend) is served. WEB_BIND=0.0.0.0 makes it reachable from other devices on the network.
WEB_PORT=8780
WEB_BIND=127.0.0.1
# Each open watch-progress stream (one per browser tab) holds one PHP thread
PHP_THREADS=24

APP_NAME=MovieBrowser3
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8780
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=7564
DB_DATABASE=moviebrowser3
DB_USERNAME=moviebrowser
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
SANCTUM_TOKEN_EXPIRATION=43200
AUTH_LOGIN_WAIT_DURATION_MS=1000

# The host-side VLC bridge (vlc_bridge.py) starts VLC for the containers
VLC_LAUNCHER=bridge
VLC_BRIDGE_PORT=8767
VLC_BRIDGE_URL=http://127.0.0.1:8767
VLC_BRIDGE_TOKEN=
VLC_TRACK_INTERVAL_SECONDS=5

WATCH_PROGRESS_STREAM_POLL_SECONDS=2
WATCH_PROGRESS_STREAM_HEARTBEAT_SECONDS=25
WATCH_PROGRESS_STREAM_LIFETIME_SECONDS=3600

WATCH_FINISHED_BEFORE_END_SECONDS=120

# Update notice: seconds a found or failed GitHub release check is reused (the repos are the installer answers above)
RELEASE_CHECK_CACHE_SECONDS=21600
RELEASE_CHECK_FAILURE_CACHE_SECONDS=600
